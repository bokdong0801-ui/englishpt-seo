d_title(title)
    ld=[
        {'@context':'https://schema.org','@type':'WebSite','name':'잉글리시PT','url':BASE_URL+'/'},
        {'@context':'https://schema.org','@type':'WebPage','name':full_title,'url':canonical,'isPartOf':{'@type':'WebSite','name':'잉글리시PT','url':BASE_URL+'/'}}
    ]
    return f'''<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{html.escape(full_title)}</title><meta name="description" content="{html.escape(desc,quote=True)}"><meta name="robots" content="{robots}"><meta name="theme-color" content="#17365D"><link rel="canonical" href="{canonical}"><meta property="og:title" content="{html.escape(full_title,quote=True)}"><meta property="og:description" content="{html.escape(desc,quote=True)}"><meta property="og:type" content="website"><meta property="og:url" content="{canonical}"><meta property="og:site_name" content="잉글리시PT"><link rel="stylesheet" href="{css}">{extra}<script type="application/ld+json">{json.dumps(ld,ensure_ascii=False,separators=(',',':'))}</script></head>'''

def footer(): return FOOTER

def card(title, count, href, desc):
    return f'<a class="hub-card" href="{href}"><span>{html.escape(title)}</span><strong>{count:,}</strong><p>{html.escape(desc)}</p><b>바로가기 →</b></a>'

counts=Counter(CATEGORY.values())
ptype_counts=Counter(r['place_type'] for r in rows if CATEGORY[r['place_id']]=='ADMIN')

# Build grouping by SIDO based on parent or relations.
def sido_names_for(pid):
    c=CATEGORY[pid]
    ids=[]
    if c=='ADMIN':
        a=ancestor_of_type(pid,'SIDO')
        if a: ids.append(a['place_id'])
    else:
        reltypes={'STATION':['STATION_IN'],'NEWTOWN':['NEWTOWN_PROJECT_OF','NEWTOWN_IN'],'DISTRICT':['DISTRICT_IN']}[c]
        targets=[]
        for rt in reltypes: targets += rel_targets.get((pid,rt),[])
        for tid in targets:
            tp=place_by_id.get(tid)
            if not tp: continue
            if c=='NEWTOWN' and ('DISTRICT' in tp.get('place_type','') or tp.get('place_type') in {'INDUSTRIAL_COMPLEX','FREE_ECONOMIC_ZONE'}):
                for at in rel_targets.get((tid,'DISTRICT_IN'),[]):
                    a=ancestor_of_type(at,'SIDO');
                    if a: ids.append(a['place_id'])
            a=ancestor_of_type(tid,'SIDO')
            if a: ids.append(a['place_id'])
    # names
    names=[]
    for sid in dict.fromkeys(ids):
        sp=place_by_id.get(sid)
        if sp: names.append(sp.get('name_ko') or sp.get('full_name_ko'))
    return names or ['기타']

