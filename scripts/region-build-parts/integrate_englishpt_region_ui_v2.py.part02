    card('행정구역',counts['ADMIN'],'/region/','시도·시군구·읍면동·리'),
    card('역',counts['STATION'],'/station/','전국 철도·도시철도 역'),
    card('신도시',counts['NEWTOWN'],'/newtown/','공식 신도시 프로젝트'),
    card('개발지구',counts['DISTRICT'],'/district/','택지·도시개발·공공주택 등')]) + '''</div></section><section class="shell hub-section"><div class="panel intro-panel"><span class="kicker">ABOUT REGION DATA</span><h2>잉글리시PT 지역정보</h2><p>지역정보 페이지는 교육 서비스 소개와 분리해 운영합니다. V5 CURRENT master의 공식 코드·상하위 계층·관계 데이터를 사용하며, 이름 유사도나 거리만으로 관계를 추정하지 않습니다.</p></div></section></main>''' + footer() + '</body></html>'
(OUT/'index.html').write_text(root,encoding='utf-8')

# Region hub.
sido_rows=[r for r in rows if r['place_type']=='SIDO']
sido_rows.sort(key=lambda r:r['name'])
type_labels=[('SIDO','시도'),('SIGUNGU','시군구'),('LEGAL_EUP','법정읍'),('LEGAL_MYEON','법정면'),('LEGAL_DONG','법정동'),('ADMIN_DONG','행정동'),('LEGAL_RI','법정리')]
region_desc='전국 시도·시군구·읍면동·리 행정구역을 공식 코드와 행정계층을 기준으로 찾아볼 수 있습니다.'
region_html=head('전국 행정구역',region_desc,BASE_URL+'/region/')+'<body>'+HEADER+'''<main id="main-content"><section class="hub-hero compact"><div class="shell"><span class="hub-eyebrow">ADMINISTRATIVE AREAS</span><h1>전국 행정구역</h1><p>시도에서 시군구, 읍면동과 리까지 행정계층을 따라 탐색합니다.</p><a class="primary-link" href="/search/?category=ADMIN">행정구역 검색하기 →</a></div></section><section class="shell hub-section"><div class="stat-strip">''' + ''.join(f'<div><strong>{ptype_counts[k]:,}</strong><span>{lab}</span></div>' for k,lab in type_labels) + '''</div><div class="panel"><div class="panel-head"><span class="kicker">BROWSE BY SIDO</span><h2>시도별 지역 찾기</h2></div><div class="sido-grid">''' + ''.join(f'<a href="{r["url_path"]}"><strong>{html.escape(r["name"])}</strong><span>지역정보 →</span></a>' for r in sido_rows) + '''</div></div></section></main>'''+footer()+'</body></html>'
(OUT/'region/index.html').write_text(region_html,encoding='utf-8')

# Generic grouped hubs for station/newtown.
def make_grouped_hub(cat, path, title, eyebrow, desc):
    grouped=defaultdict(list)
    for r in rows:
        if CATEGORY[r['place_id']] != cat: continue
        for sn in sido_names_for(r['place_id']): grouped[sn].append(r)
    for g in grouped: grouped[g].sort(key=lambda x:x['name'])
    sections=[]
    for g in sorted(grouped):
        links=''.join(f'<a href="{r["url_path"]}"><strong>{html.escape(r["name"])}</strong><small>{html.escape(r["type_label"])}</small></a>' for r in grouped[g])
        sections.append(f'<details class="hub-group" open><summary><span>{html.escape(g)}</span><b>{len(grouped[g]):,}</b></summary><div class="entity-grid">{links}</div></details>')
    h=head(title,desc,BASE_URL+path)
    body='<body>'+HEADER+f'''<main id="main-content"><section class="hub-hero compact"><div class="shell"><span class="hub-eyebrow">{eyebrow}</span><h1>{title}</h1><p>{desc}</p><a class="primary-link" href="/search/?category={cat}">이 범위에서 검색하기 →</a></div></section><section class="shell hub-section"><p class="hub-count">총 {counts[cat]:,}개</p>{''.join(sections)}</section></main>'''+footer()+'</body></html>'
    (OUT/path.strip('/')/'index.html').write_text(h+body,encoding='utf-8')

make_grouped_hub('STATION','/station/','전국 역 찾기','STATIONS','전국 철도·도시철도 역을 소재 지역과 공식 관계 데이터로 찾아볼 수 있습니다.')
make_grouped_hub('NEWTOWN','/newtown/','전국 신도시','NEWTOWNS','공식 신도시 프로젝트와 연결된 개발사업·행정구역 관계를 확인합니다.')

# District hub grouped by place_type.
district_groups=defaultdict(list)
for r in rows:
    if CATEGORY[r['place_id']]=='DISTRICT': district_groups[r['type_label']].append(r)
for g in district_groups: district_groups[g].sort(key=lambda x:x['name'])
dsections=[]
for g in sorted(district_groups, key=lambda k:(-len(district_groups[k]),k)):
    links=''.join(f'<a href="{r["url_path"]}"><strong>{html.escape(r["name"])}</strong><small>{html.escape(" · ".join(sido_names_for(r["place_id"])))}</small></a>' for r in district_groups[g])
    dsections.append(f'<details class="hub-group"><summary><span>{html.escape(g)}</span><b>{len(district_groups[g]):,}</b></summary><div class="entity-grid">{links}</div></details>')
desc='택지개발·도시개발·공공주택·산업단지 등 전국 개발지구를 사업 유형별로 찾아볼 수 있습니다.'
district_html=head('전국 개발지구',desc,BASE_URL+'/district/')+'<body>'+HEADER+f'''<main id="main-content"><section class="hub-hero compact"><div class="shell"><span class="hub-eyebrow">DEVELOPMENT DISTRICTS</span><h1>전국 개발지구</h1><p>{desc}</p><a class="primary-link" href="/search/?category=DISTRICT">개발지구 검색하기 →</a></div></section><section class="shell hub-section"><p class="hub-count">총 {counts['DISTRICT']:,}개 · {len(district_groups):,}개 유형</p>{''.join(dsections)}</section></main>'''+footer()+'</body></html>'
(OUT/'district/index.html').write_text(district_html,encoding='utf-8')

