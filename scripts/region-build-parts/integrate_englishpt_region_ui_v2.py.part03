n></div><p id="search-status" class="search-status" aria-live="polite">검색 데이터를 불러오는 중입니다.</p></div><div id="search-results" class="search-results"><div class="search-empty"><strong>지역명을 입력해보세요.</strong><p>법정동·행정동·리뿐 아니라 역, 신도시, 개발지구까지 한 번에 찾을 수 있습니다.</p></div></div></section></main>'''+footer()+'</body></html>'
(OUT/'search/index.html').write_text(search_html,encoding='utf-8')

search_js=r'''(()=>{const $=s=>document.querySelector(s);const input=$('#region-search'),results=$('#search-results'),status=$('#search-status'),btn=$('#search-button'),filters=[...document.querySelectorAll('[data-cat]')];let data=[],cat='ALL',timer=null;const norm=s=>(s||'').toLowerCase().replace(/\s+/g,' ').trim();const esc=s=>(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));function categoryLabel(c){return {ADMIN:'행정구역',STATION:'역',NEWTOWN:'신도시',DISTRICT:'개발지구'}[c]||c}function run(){const q=norm(input.value);const list=data.filter(r=>(cat==='ALL'||r.c===cat)&&(!q||r.q.includes(q))).sort((a,b)=>{const an=norm(a.n),bn=norm(b.n);const sa=an===q?0:an.startsWith(q)?1:a.q.startsWith(q)?2:3;const sb=bn===q?0:bn.startsWith(q)?1:b.q.startsWith(q)?2:3;return sa-sb||a.n.localeCompare(b.n,'ko')}).slice(0,50);const total=data.reduce((n,r)=>n+((cat==='ALL'||r.c===cat)&&(!q||r.q.includes(q))?1:0),0);status.textContent=q?`${total.toLocaleString()}개 결과${total>50?' · 상위 50개 표시':''}`:`${cat==='ALL'?'전체':categoryLabel(cat)} ${total.toLocaleString()}개`;if(!q){results.innerHTML='<div class="search-empty"><strong>검색어를 입력해보세요.</strong><p>정확한 이름뿐 아니라 등록된 별칭도 함께 검색합니다.</p></div>';return}if(!list.length){results.innerHTML='<div class="search-empty"><strong>검색 결과가 없습니다.</strong><p>지역명을 줄이거나 다른 표기로 다시 검색해보세요.</p></div>';return}results.innerHTML=list.map(r=>`<a class="result-card" href="${r.u}"><div><span class="result-type">${categoryLabel(r.c)} · ${esc(r.t)}</span><h2>${esc(r.f||r.n)}</h2>${r.x&&r.x!==r.f?`<p>${esc(r.x)}</p>`:''}${r.a&&r.a.length?`<small>별칭: ${esc(r.a.slice(0,4).join(', '))}</small>`:''}</div><b>보기 →</b></a>`).join('')}function schedule(){clearTimeout(timer);timer=setTimeout(run,130)}filters.forEach(f=>f.addEventListener('click',()=>{filters.forEach(x=>x.classList.remove('on'));f.classList.add('on');cat=f.dataset.cat;run()}));input.addEventListener('input',schedule);btn.addEventListener('click',run);fetch('/assets/search-index.json').then(r=>r.json()).then(j=>{data=j;const u=new URL(location.href),q=u.searchParams.get('q')||'',c=u.searchParams.get('category');if(c&&['ADMIN','STATION','NEWTOWN','DISTRICT'].includes(c)){cat=c;filters.forEach(x=>x.classList.toggle('on',x.dataset.cat===c))}input.value=q;status.textContent=`전체 ${data.length.toLocaleString()}개 데이터 검색 가능`;if(q)run()}).catch(()=>{status.textContent='검색 데이터를 불러오지 못했습니다.'})})();'''
(OUT/'assets/search.js').write_text(search_js,encoding='utf-8')

# Append CSS for integrated UI.
css_path=OUT/'assets/region.css'
css=css_path.read_text(encoding='utf-8')
css += r'''
/* EnglishPT region UI v2 */
.skip-link{position:absolute;left:-9999px;top:8px;background:#fff;color:#14283d;padding:10px 14px;border-radius:8px;z-index:100}.skip-link:focus{left:12px}.brand-wrap{display:flex;align-items:center;gap:10px}.brand{font-size:18px;letter-spacing:-.02em;color:var(--navy)}.brand-section{font-size:11px;font-weight:850;color:var(--blue);background:var(--soft);padding:5px 9px;border-radius:999px}.mobile-nav{display:none;position:relative}.mobile-nav summary{list-style:none;font-size:12px;font-weight:800;color:var(--navy);cursor:pointer;border:1px solid var(--line);border-radius:9px;padding:7px 10px}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav>div{position:absolute;right:0;top:42px;width:180px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px;box-shadow:var(--shadow)}.mobile-nav a{display:block;padding:10px 11px;border-radius:9px;font-size:13px;font-weight:750}.mobile-nav a:hover{background:var(--soft)}.site-footer{background:#102842;color:#fff;padding:34px 0}.footer-grid{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:start}.site-footer strong{font-size:17px;letter-spacing:-.02em}.site-footer p{margin:6px 0 0;color:#9fb4ca;font-size:12px}.site-footer nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:14px 18px}.site-footer nav a{font-size:12px;color:#c5d4e3}.site-footer nav a:hover{color:#fff}.hub-hero{padding:70px 0 54px;background:linear-gradient(135deg,#102842,#173f6f);color:#fff}.hub-hero.compact{padding:54px 0 44px}.hub-eyebrow{display:inline-block;font-size:10px;font-weight:900;letter-spacing:.15em;color:#a7c8ef;margin-bottom:12px}.hub-hero h1{font-size:clamp(34px,5vw,58px);max-width:850px;margin-bottom:16px}.hub-hero.compact h1{font-size:clamp(32px,4vw,48px)}.hub-hero p{color:#c8d7e7;max-width:720px;font-size:15px;margin:0 0 24px}.hero-search{display:flex;max-width:660px;padding:7px;background:#fff;border-radius:16px;box-shadow:0 14px 40px rgba(0,0,0,.18)}.hero-search input{min-width:0;flex:1;border:0;outline:0;padding:11px 13px;font:inherit;font-size:14px}.hero-search button,.primary-link{border:0;background:var(--blue);color:#fff;border-radius:11px;padding:11px 18px;font:inherit;font-size:13px;font-weight:850;cursor:pointer}.primary-link{display:inline-flex}.hub-section{padding:36px 0}.hub-card-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.hub-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 6px 20px rgba(24,54,93,.05)}.hub-card span{display:block;color:var(--blue);font-size:12px;font-weight:850}.hub-card strong{display:block;font-size:30px;margin:7px 0 6px}.hub-card p{font-size:12px;color:var(--muted);margin:0 0 16px}.hub-card b{font-size:11px;color:var(--navy)}.intro-panel{max-width:900px}.intro-panel p{color:var(--muted);font-size:14px}.stat-strip{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;margin-bottom:18px}.stat-strip>div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 10px;text-align:center}.stat-strip strong{display:block;font-size:18px}.stat-strip span{display:block;font-size:10px;color:var(--muted);margin-top:3px}.sido-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.sido-grid a{display:flex;justify-content:space-between;align-items:center;gap:10px;background:#f8fafc;border:1px solid var(--line);border-radius:13px;padding:13px}.sido-grid strong{font-size:13px}.sido-grid span{font-size:10px;color:var(--blue)}.hub-group{background:#fff;border:1px solid var(--line);border-radius:18px;margin-bottom:12px;overflow:hidden}.hub-group summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:16px 18px;font-size:14px;font-weight:850;list-style:none}.hub-group summary::-webkit-details-marker{display:none}.hub-group summary b{font-size:11px;color:var(--blue);background:var(--soft);padding:5px 9px;border-radius:999px}.entity-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border-top:1px solid var(--line)}.entity-grid a{background:#fff;padding:12px 14px;min-width:0}.entity-grid strong{display:block;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.entity-grid small{display:block;margin-top:3px;font-size:10px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.search-section{padding:34px 0 54px;min-height:55vh}.search-box{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 7px 24px rgba(24,54,93,.05);margin-bottom:18px}.search-box>label{display:block;font-size:12px;font-weight:850;margin-bottom:8px}.search-input-row{display:flex;gap:8px}.search-input-row input{min-width:0;flex:1;border:1px solid var(--line);border-radius:12px;padding:13px 14px;font:inherit;font-size:14px;outline:none}.search-input-row input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(36,104,201,.1)}.search-input-row button{border:0;border-radius:12px;background:var(--blue);color:#fff;font:inherit;font-size:13px;font-weight:850;padding:0 20px}.filter-row{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.filter-row button{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:999px;padding:7px 11px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}.filter-row button.on{background:var(--navy);border-color:var(--navy);color:#fff}.search-status{font-size:11px;color:var(--muted);margin:12px 0 0}.search-results{display:grid;gap:9px}.result-card{display:flex;justify-content:space-between;align-items:center;gap:18px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:17px 19px}.result-card:hover{border-color:#aac8eb;box-shadow:0 5px 18px rgba(24,54,93,.06)}.result-type{font-size:10px;font-weight:850;color:var(--blue)}.result-card h2{font-size:16px;margin:3px 0 3px}.result-card p,.result-card small{display:block;font-size:11px;color:var(--muted);margin:0}.result